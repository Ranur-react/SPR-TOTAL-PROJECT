<div class="col-md-6">
    <label for="nama" class="form-label">Nama Proyek</label>
    <input type="text" class="form-control" id="namaProyek" required>
    <div class="invalid-feedback">
        Please provide a valid name proyek
    </div>
</div>
<div class="col-md-6">
    <label for="lokasi" class="form-label">Lokasi Proyek</label>
    <input type="text" class="form-control" id="lokasiProyek" required>
    <div class="invalid-feedback">
        Please provide a valid lokasi proyek.
    </div>
</div>
<div class="col-md-12">
    <label for="tanggalMulai" class="form-label">Tanggal Mulai Proyek</label>
    <input type="text" class="form-control datepicker" id="tanggalMulai" placeholder="YYYY-MM-DD">
    <div class="invalid-feedback">
        tulis error tanggal disini
    </div>
</div>
<div class="col-md-12">
    <label for="tanggalSelesai" class="form-label">Tanggal Selesai Proyek</label>
    <input type="text" class="form-control datepicker" id="tanggalSelesai" placeholder="YYYY-MM-DD">
    <div class="invalid-feedback">
        tulis error tanggal disini
    </div>
</div>